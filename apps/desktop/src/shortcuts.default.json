{
  "version": 1,
  "shortcuts": {
    "command.palette": {
      "label": {
        "ko": "명령 팔레트",
        "en": "Command Palette"
      },
      "description": {
        "ko": "명령을 검색해 실행합니다.",
        "en": "Search and run commands."
      },
      "mac": "Command+K",
      "windows": "Ctrl+K",
      "editable": true
    },
    "project.new": {
      "label": {
        "ko": "새 워크스페이스",
        "en": "New Workspace"
      },
      "description": {
        "ko": "빈 워크스페이스를 만듭니다.",
        "en": "Create an empty workspace."
      },
      "mac": "Command+N",
      "windows": "Ctrl+N",
      "editable": true
    },
    "project.open": {
      "label": {
        "ko": "기존 워크스페이스 추가",
        "en": "Add Existing Workspace"
      },
      "description": {
        "ko": "로컬 폴더를 워크스페이스로 추가합니다.",
        "en": "Add a local folder as a workspace."
      },
      "mac": "Command+O",
      "windows": "Ctrl+O",
      "editable": true
    },
    "project.switch": {
      "label": {
        "ko": "워크스페이스 전환",
        "en": "Switch Workspace"
      },
      "description": {
        "ko": "등록된 워크스페이스 목록을 엽니다.",
        "en": "Open the registered workspace switcher."
      },
      "mac": "Command+Shift+O",
      "windows": "Ctrl+Shift+O",
      "editable": true
    },
    "nav.explore": {
      "label": {
        "ko": "탐색",
        "en": "Explore"
      },
      "description": {
        "ko": "Dock 탐색 화면으로 이동합니다.",
        "en": "Go to the dock Explore view."
      },
      "mac": "Command+1",
      "windows": "Ctrl+1",
      "editable": true
    },
    "nav.installed": {
      "label": {
        "ko": "설치됨",
        "en": "Installed"
      },
      "description": {
        "ko": "설치된 dock 화면으로 이동합니다.",
        "en": "Go to the Installed view."
      },
      "mac": "Command+2",
      "windows": "Ctrl+2",
      "editable": true
    },
    "nav.logs": {
      "label": {
        "ko": "로그",
        "en": "Logs"
      },
      "description": {
        "ko": "워크스페이스 로그 화면으로 이동합니다.",
        "en": "Go to the workspace Logs view."
      },
      "mac": "Command+3",
      "windows": "Ctrl+3",
      "editable": true
    },
    "project.updateAll": {
      "label": {
        "ko": "전체 업데이트",
        "en": "Update All"
      },
      "description": {
        "ko": "현재 워크스페이스의 dock을 업데이트합니다.",
        "en": "Update docks in the active workspace."
      },
      "mac": "Command+U",
      "windows": "Ctrl+U",
      "editable": true
    },
    "dock.refresh": {
      "label": {
        "ko": "Registry 새로고침",
        "en": "Refresh Registry"
      },
      "description": {
        "ko": "Dock 목록을 다시 가져옵니다.",
        "en": "Refresh the dock catalog."
      },
      "mac": "Command+R",
      "windows": "Ctrl+R",
      "editable": true
    },
    "dock.install": {
      "label": {
        "ko": "Dock 설치",
        "en": "Install Dock"
      },
      "description": {
        "ko": "상세 화면의 dock을 설치합니다.",
        "en": "Install the dock shown in detail."
      },
      "mac": "Command+Enter",
      "windows": "Ctrl+Enter",
      "editable": true
    }
  }
}
