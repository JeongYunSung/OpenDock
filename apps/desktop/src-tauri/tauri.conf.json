{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenDock",
  "version": "0.1.51",
  "identifier": "app.opendock.desktop",
  "build": {
    "beforeDevCommand": "bun run prepare:sidecars && bun run dev:web",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "bun run prepare:sidecars && bun run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "OpenDock",
        "width": 1180,
        "height": 760,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "resizable": true,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    },
    "resources": [
      "../LICENSE",
      "../THIRD_PARTY_NOTICES.md"
    ],
    "externalBin": [
      "binaries/opendock"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlDNjIwNjBGRTBGQ0ZCOTAKUldTUSsvemdEd1ppbk9OWUIrNUs1K1pRMUFhRHhjZkcxUzRJTGtEME1YMkhVTnhrZ1lGK0VLMGwK",
      "endpoints": [
        "https://github.com/JeongYunSung/OpenDockReleases/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
