{
  "name": "opendock",
  "version": "0.1.61",
  "description": "Choose and combine AI setup docks for every workspace.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "opendock": "bin/opendock"
  },
  "files": [
    "bin",
    "assets/opendock-logo-96.png",
    "docs",
    "examples",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "README.md",
    "README.*.md"
  ],
  "scripts": {
    "dev": "bun run src/cli.ts",
    "build": "bun run scripts/build.ts",
    "generate:licenses": "cd ../.. && bun run generate:licenses",
    "prepare:github-package": "bun run scripts/prepare-github-package.ts",
    "test": "vitest run --testTimeout 15000 --no-file-parallelism",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "check": "bun run typecheck && bun run test && bun run lint",
    "prepack": "bun run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/node": "^22.18.6",
    "commander": "^14.0.3",
    "tar": "^7.5.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18",
    "yaml": "^2.8.2",
    "zod": "^4.3.6"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "packageManager": "bun@1.3.11"
}
