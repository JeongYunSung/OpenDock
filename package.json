{
  "name": "opendock",
  "version": "0.1.0",
  "description": "Approved starterpacks for AI workspaces.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "opendock": "./bin/opendock.js"
  },
  "files": [
    "bin",
    "src",
    "examples",
    "README.md",
    "README.*.md"
  ],
  "scripts": {
    "dev": "bun run src/cli.ts",
    "build": "bun build src/cli.ts --outfile bin/opendock.js --target node && chmod +x bin/opendock.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "check": "bun run typecheck && bun run test && bun run lint",
    "prepack": "bun run build"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "tar": "^7.5.2",
    "yaml": "^2.8.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/node": "^22.18.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "bun@1.3.11"
}
