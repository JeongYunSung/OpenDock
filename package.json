{
  "name": "opendock-monorepo",
  "private": true,
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "packages/cli",
    "apps/desktop"
  ],
  "scripts": {
    "generate:licenses": "node scripts/generate-license-notices.mjs",
    "dev:cli": "cd packages/cli && bun run dev",
    "build:cli": "cd packages/cli && bun run build",
    "check:cli": "cd packages/cli && bun run check",
    "dev:desktop": "cd apps/desktop && bun run dev",
    "build:desktop": "cd apps/desktop && bun run build",
    "verify:desktop": "cd apps/desktop && bun run verify",
    "check": "bun run check:cli && bun run verify:desktop"
  },
  "packageManager": "bun@1.3.11"
}
